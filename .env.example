# Postgres — em produção (Vercel), preenchido automaticamente pela integração Neon.
# Em dev local, aponte as duas para o mesmo Postgres (ex.: o do docker-compose.yml).
DATABASE_URL="postgresql://biogreen:biogreen@localhost:5432/biogreen?schema=public"
DATABASE_URL_UNPOOLED="postgresql://biogreen:biogreen@localhost:5432/biogreen?schema=public"

# Assinatura do cookie de sessão (JWT). Gere um valor aleatório forte em produção.
SESSION_SECRET="troque-este-valor-em-producao"

# Storage de anexos (FISPQ, COA, DANFE, fotos). Sem este token, os arquivos caem
# automaticamente em disco local (storage/attachments/) — útil para rodar sem depender da nuvem.
BLOB_READ_WRITE_TOKEN=""

# IA — módulo "Cérebro" (nunca exposta ao frontend).
ANTHROPIC_API_KEY=""
